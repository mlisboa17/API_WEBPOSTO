# LOGOS SPACE — Configuração raiz (copie para .env)
# NUNCA commite o arquivo .env

WEBPOSTO_BASE_URL=https://web.qualityautomacao.com.br
WEBPOSTO_BEARER_TOKEN=sua_chave_api_rest_aqui

# Security (gere novos valores para cada ambiente)
JWT_PRIVATE_KEY=gerar_chave_privada_jwt
JWT_PUBLIC_KEY=gerar_chave_publica_jwt
AES_KEY=gerar_aes_key_base64
SECRET_KEY=gerar_secret_key
DB_PASSWORD=senha_banco_local
REDIS_PASSWORD=senha_redis_local
BCRYPT_ROUNDS=12
DATABASE_URL=postgresql+asyncpg://webposto:changeme@localhost:5433/webposto
