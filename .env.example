# ============ webPosto API ============
# OBRIGATÓRIO: URL base da API webPosto
WEBPOSTO_BASE_URL=http://webposto.localhost:3000/api

# OBRIGATÓRIO: Bearer token para autenticação
WEBPOSTO_BEARER_TOKEN=seu_bearer_token_aqui

# OPCIONAL: Chave API alternativa
WEBPOSTO_API_KEY=
WEBPOSTO_API_SECRET=

# Network
WEBPOSTO_TIMEOUT=30
WEBPOSTO_MAX_RETRIES=3
WEBPOSTO_RETRY_DELAY=1.0

# true = a API não sobe sem .env válido + health do WebPosto (sem dados fictícios)
WEBPOSTO_STRICT_STARTUP=true

# Ajuste se o gateway usar outros paths
# WEBPOSTO_V1_HEALTH=/v1/health
# WEBPOSTO_V1_DESPESAS=/v1/financeiro/despesas
# WEBPOSTO_V1_FECHAMENTOS=/v1/financeiro/fechamentos

# ============ Logos Eye (Monitoramento) ============
LOGOS_EYE_ENABLED=true
LOGOS_EYE_URL=http://logos-eye.localhost:5000
LOGOS_EYE_API_KEY=

# ============ Logos Space (Persistência) ============
LOGOS_SPACE_ENABLED=true
LOGOS_SPACE_DB=mongodb://localhost:27017/logos

# ============ Vorcaro (Analytics) ============
VORCARO_ENABLED=false
VORCARO_URL=http://vorcaro.localhost:6000
VORCARO_API_KEY=

# ============ App ============
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
TZ=America/Sao_Paulo
