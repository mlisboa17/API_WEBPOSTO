# ============================================================
# Logos Auditoria - Production Environment
# ============================================================
# CRÍTICO: Nunca commitar este arquivo no git!
# Usar: AWS Secrets Manager, HashiCorp Vault, ou Sealed Secrets (K8s)
# ============================================================

# ============ webPosto API (PRODUÇÃO) ============
WEBPOSTO_BASE_URL=https://webposto.production.com/api
WEBPOSTO_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Network
WEBPOSTO_TIMEOUT=30
WEBPOSTO_MAX_RETRIES=3
WEBPOSTO_RETRY_DELAY=1.0

# ============ Logos Eye (Monitoramento) ============
LOGOS_EYE_ENABLED=true
LOGOS_EYE_URL=https://logos-eye.production.com
LOGOS_EYE_API_KEY=eye_key_prod_xyz123...

# ============ Logos Space (Persistência) ============
LOGOS_SPACE_ENABLED=true
LOGOS_SPACE_DB=mongodb://admin:senha_secreta@mongo-1:27017,mongo-2:27017,mongo-3:27017/logos?replicaSet=rs0&authSource=admin

# ============ Vorcaro (Analytics) ============
VORCARO_ENABLED=true
VORCARO_URL=https://vorcaro.production.com
VORCARO_API_KEY=vorcaro_key_prod_xyz123...

# ============ MongoDB (Logos Space) ============
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=senha_super_secreta_aleatoria_aqui_123456

# ============ Redis (Cache) ============
REDIS_URL=redis://redis:6379/0

# ============ Application ============
DEBUG=false
LOG_LEVEL=WARNING
HOST=0.0.0.0
PORT=8000
TZ=America/Sao_Paulo
APP_NAME=Logos Auditoria Production

# ============ Security ============
# CORS
ALLOWED_ORIGINS=https://auditoria.production.com,https://app.production.com

# Rate Limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# ============ Monitoring & Logging ============
# ELK Stack
ELASTICSEARCH_URL=https://elasticsearch.production.com:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elasticsearch_password_xyz

# Datadog (opcional)
DATADOG_API_KEY=dd_api_key_xyz
DATADOG_APP_KEY=dd_app_key_xyz

# ============ Backup ============
# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
BACKUP_BUCKET=logos-auditoria-backups
BACKUP_SCHEDULE=daily

# ============ Alerting ============
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#logos-alerts

# PagerDuty (opcional)
PAGERDUTY_API_KEY=pagerduty_key_xyz
PAGERDUTY_SERVICE_ID=service_id_xyz

# ============ Email (para notificações) ============
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=sendgrid_api_key_xyz
MAIL_FROM=alerts@logos.production.com

# ============ SSL/TLS ============
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_VERIFY=true

# ============ Feature Flags ============
FEATURE_LOGOS_EYE_INTEGRATION=true
FEATURE_LOGOS_SPACE_INTEGRATION=true
FEATURE_VORCARO_ANALYTICS=true
FEATURE_EMAIL_ALERTS=true

# ============================================================
# IMPORTANTE: Mudar todas as senhas/tokens antes de ir pro ar!
# ============================================================
