# GEMINI 2.0: Production-Grade Multi-Stage Build
# Multi-stage: Node 22 (build) -> Python 3.12-slim (runtime) -> <250MB
# Security: Non-root user, no shell, hardened

FROM node:22-alpine AS builder-node
LABEL stage=builder
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++ cairo-dev jpeg-dev pango-dev giflib-dev pixman-dev

# Copy Reflex frontend source
COPY rxconfig.py .
COPY src/presentation/frontend/ ./src/presentation/frontend/
COPY requirements-frontend.txt .

# Build Reflex frontend (Turbopack)
RUN npm ci && npm run build && npm prune --production

# ============================================================================
# Stage 2: Python Runtime (security-hardened)
# ============================================================================
FROM python:3.12-slim

LABEL maintainer="LogosSpace Security Team"
LABEL version="1.0.0"
LABEL description="Production Reflex Frontend with Security Hardening"

# Set environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app" \
    NODE_ENV=production \
    ENVIRONMENT=production \
    DEBUG=false

# Install system dependencies (minimal + security tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    curl \
    brotli \
    libvips-tools \
    dumb-init \
    gosu \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================================================
# Security Hardening: Create non-root user (appuser)
# ============================================================================
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# Copy only built artifacts from builder
COPY --from=builder-node --chown=appuser:appgroup /app/dist ./dist
COPY --from=builder-node --chown=appuser:appgroup /app/node_modules ./node_modules

# Copy Python source (minimal footprint)
COPY --chown=appuser:appgroup requirements-frontend.txt .
COPY --chown=appuser:appgroup src/presentation/frontend/ ./src/presentation/frontend/
COPY --chown=appuser:appgroup src/domain/ ./src/domain/
COPY --chown=appuser:appgroup src/infrastructure/security/ ./src/infrastructure/security/
COPY --chown=appuser:appgroup rxconfig.py .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-frontend.txt

# ============================================================================
# Security Hardening: Remove shell access (no /bin/sh, /bin/bash)
# ============================================================================
RUN rm -rf /bin/sh /bin/bash /usr/bin/env /tmp/* /var/tmp/* \
    && find / -name "*.pyc" -delete \
    && find / -name "__pycache__" -delete \
    && chmod 755 /app

# ============================================================================
# Healthcheck: JWT Key exists + DB connectivity
# ============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -sf http://localhost:3000/health || exit 1

# Switch to non-root user
USER appuser

# Expose ports
EXPOSE 3000 8000

# Use dumb-init to handle signals properly
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start Reflex dev server (for production use, replace with production ASGI server)
CMD ["reflex", "run", "--env", "prod"]
