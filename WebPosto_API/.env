# =============================================================================
# REDE LISBÔA — APIs WebPosto
# =============================================================================
WEBPOSTO_REDE_NOME=LISBÔA
# Defina abaixo qual chave de API está ATIVA no momento para o gateway.
# Você pode apontar diretamente para uma das chaves das unidades abaixo.
WEBPOSTO_API_KEY=4d6bbe21-92b2-4052-bcb5-a82c86858fd7

# 📍 Unidade 1: POSTO VIP RIO DOCE (Olinda/PE) - ATIVO
WEBPOSTO_API_KEY_POSTO_VIP_RIO_DOCE=4d6bbe21-92b2-4052-bcb5-a82c86858fd7

# 📍 Unidade 2: POSTO CASA CAIADA (Olinda/PE)
WEBPOSTO_API_KEY_POSTO_CASA_CAIADA=eabd1f99-5c9b-49dc-b916-95e75dd753a8

# 📍 Chave de Desenvolvimento / Sandbox (Alternativa)
WEBPOSTO_API_KEY_POSTO_VIP_DEV=03afc3f0-590b-44cf-99a1-e4dd74ac7478

# Configurações de conexões gerais com o WebPosto
WEBPOSTO_BASE_URL=https://web.qualityautomacao.com.br
WEBPOSTO_VIP_POSTO_ID=VIP
WEBPOSTO_VIP_POSTO_NOME=POSTO_VIP


# =================================================================------------

# Gateway Security
CONSUMER_TOKEN=dev-consumer-token
ADMIN_TOKEN=dev-admin-token

# FastAPI
API_HOST=0.0.0.0
API_PORT=8050
API_WORKERS=4
DEBUG=True
LOG_LEVEL=INFO

# Banco de Dados (SQLite async com aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./logos_gateway.db

# Redis (in-memory opcional)
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
