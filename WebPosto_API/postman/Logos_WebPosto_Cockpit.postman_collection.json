    {
      "name": "3 · Proxy (igual dashboard operacional)",
      "item": [
        {
          "name": "POST proxy → EMPRESAS",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"path\": \"/INTEGRACAO/EMPRESAS\",\n  \"method\": \"GET\",\n  \"query\": {},\n  \"use_cache\": true\n}"
            },
            "url": "{{gateway_url}}/api/webposto/proxy"
          }
        },
        {
          "name": "POST proxy → CAIXA_APRESENTADO",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"path\": \"/INTEGRACAO/CAIXA_APRESENTADO\",\n  \"method\": \"GET\",\n  \"query\": {\n    \"dataInicial\": \"{{data_inicial}}\",\n    \"dataFinal\": \"{{data_final}}\"\n  },\n  \"use_cache\": true\n}"
            },
            "url": "{{gateway_url}}/api/webposto/proxy"
          }
        },
        {
          "name": "POST proxy → ABASTECIMENTO",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"path\": \"/INTEGRACAO/ABASTECIMENTO\",\n  \"method\": \"GET\",\n  \"query\": {\n    \"dataInicial\": \"{{data_inicial}}\",\n    \"dataFinal\": \"{{data_final}}\",\n    \"pagina\": 0,\n    \"tamanhoPagina\": 50\n  },\n  \"use_cache\": true\n}"
            },
            "url": "{{gateway_url}}/api/webposto/proxy"
          }
