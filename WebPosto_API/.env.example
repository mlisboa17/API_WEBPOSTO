# =============================================================================
# LOGOS SPACE — WebPosto API (copie para .env e preencha)
# NUNCA commite o arquivo .env
# =============================================================================
WEBPOSTO_REDE_NOME=SUA_REDE
WEBPOSTO_API_KEY_POSTO_VIP_RIO_DOCE=sua_chave_unidade_vip
WEBPOSTO_API_KEY_POSTO_CASA_CAIADA=sua_chave_unidade_casa_caiada
WEBPOSTO_API_KEY_POSTO_DOZE_FILIAL_II=sua_chave_unidade_posto_doze

WEBPOSTO_BASE_URL=https://web.qualityautomacao.com.br
WEBPOSTO_VIP_POSTO_ID=VIP
WEBPOSTO_VIP_POSTO_NOME=POSTO_VIP
WEBPOSTO_SYNC_INTERVAL_SECONDS=3600
WEBPOSTO_TIMEOUT_SECONDS=30

# Gateway Security (desenvolvimento — gere valores únicos)
CONSUMER_TOKEN=dev-consumer-token-change-me
ADMIN_TOKEN=dev-admin-token-change-me

# FastAPI
API_HOST=0.0.0.0
API_PORT=8040
API_WORKERS=4
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
DEPARTMENTAL_SCHEDULER_ENABLED=false
DEPARTMENTAL_SCHEDULER_POLL_SECONDS=60
PERIODIC_AUDIT_DOSSIER_BACKUP_DIR=.runtime/periodic_audits/dossier_backups
PERIODIC_AUDIT_DOSSIER_RETENTION_DAYS=2555
# Webhook HTTPS opcional para entrega ativa das notificações executivas.
EXECUTIVE_NOTIFICATION_WEBHOOK_URL=

# Autenticação. Em produção: DEBUG=false, senha em hash, cookie seguro e
# origens HTTPS explícitas. Nunca use os valores de desenvolvimento.
SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes
AUTH_USER_EMAIL=admin@example.com
AUTH_USER_PASSWORD=troque-em-desenvolvimento
AUTH_USER_PASSWORD_HASH=
AUTH_USER_ROLE=director
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8040,http://localhost:8040

# Banco de Dados
DATABASE_URL=sqlite+aiosqlite:///./logos_gateway.db
REDIS_URL=redis://localhost:6379/0

# Supabase (persistência de Adquirente/Bandeira/TaxaOperadora/PrazoRecebimento)
# Use a service role key (uso interno do backend) — NUNCA exponha ao frontend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=sua_service_role_key
