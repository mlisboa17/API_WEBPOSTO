# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./logos_gateway.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8050
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# WebPosto External API Configuration
WEBPOSTO_API_URL=https://api.webposto.com
WEBPOSTO_API_TIMEOUT=10

# Cache Configuration
CACHE_TTL_MINUTES=5
CACHE_ENABLED=true

# Security (será preenchido com chaves reais em produção)
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

